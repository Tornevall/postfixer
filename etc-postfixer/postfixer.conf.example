# Postfixer node configuration.
# Installed as /etc/postfix/postfixer.d/postfixer.conf by the interactive customizer.

# inout = inbound/outbound final delivery server with Maildir, Courier and SMTP AUTH
# relay = relay helper with SMTP AUTH, but no local Maildir/IMAP/POP delivery
POSTFIXER_ROLE=inout

# SMTP identity. Postfixer applies this as the system hostname so Postfix can use
# its normal $myhostname default without putting a server-specific hostname in
# the repository main.cf.
POSTFIXER_HOSTNAME=mail.example.com
POSTFIXER_MAIL_DOMAIN=example.com

# Use Postfix destination syntax. Leave empty for direct Internet delivery.
# Relay-to-relay traffic normally uses SMTP/25 between trusted nodes, for example:
# POSTFIXER_RELAYHOST='[relay-2.example.com]'
# POSTFIXER_FALLBACK_RELAYS='[relay-3.example.com] [relay-4.example.com]'
# Port 587 is reserved for authenticated end-user submission on both roles.
POSTFIXER_RELAYHOST=
POSTFIXER_FALLBACK_RELAYS=

# Certificate is managed externally and synchronized below /etc/letsencrypt.
POSTFIXER_CERT_DOMAIN=mail.example.com

POSTFIXER_NETWORKS_FILE=/etc/postfix/postfixer.d/networks
POSTFIXER_LOCAL_DOMAINS_FILE=/etc/postfix/postfixer.d/local-domains
POSTFIXER_RELAY_DOMAINS_FILE=/etc/postfix/postfixer.d/relay-domains
POSTFIXER_RELAY_RECIPIENTS_FILE=/etc/postfix/postfixer.d/relay-recipients
POSTFIXER_TRANSPORT_FILE=/etc/postfix/postfixer.d/transport
POSTFIXER_DKIM_DIR=/etc/opendkim
